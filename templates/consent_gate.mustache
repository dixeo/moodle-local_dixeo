{{!
    @template local_dixeo/consent_gate

    Non-dismissible terms and privacy lock for a Dixeo course.

    Context variables required:
    * title - Dialog title
    * sections - Notice sections
    * termscheckbox - Terms checkbox label
    * processingcheckbox - Usage analytics checkbox label
    * continuelabel - Continue button label
    * exitlabel - Exit link label
    * actionurl - Form action
    * sesskey - Session key
    * courseid - Course id
    * returnurl - Local URL to reopen after Continue
    * exiturl - Site home
    * version - Document version

    Example context (json):
    {
        "title": "Terms of Use and Privacy Notice",
        "sections": [
            {
                "id": "local-dixeo-consent-terms-section",
                "heading": "Terms of Use",
                "blocks": [
                    {
                        "paragraph": "These terms are a contract."
                    }
                ]
            }
        ],
        "termscheckbox": "I have read and agree to the Terms of Use and acknowledge the Privacy Notice.",
        "processingcheckbox": "My tutor usage will be recorded for usage analytics and reports.",
        "continuelabel": "Continue",
        "exitlabel": "Exit",
        "actionurl": "https://example.com/local/dixeo/consent.php",
        "sesskey": "sesskey",
        "courseid": 2,
        "returnurl": "https://example.com/course/view.php?id=2",
        "exiturl": "https://example.com/",
        "version": "2026-10-15.1"
    }
}}
<div class="local-dixeo-consent-lock" data-region="local-dixeo-consent-lock">
    <div class="local-dixeo-consent-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="local-dixeo-consent-title"
         tabindex="-1">
        <h2 id="local-dixeo-consent-title" class="local-dixeo-consent-title">{{title}}</h2>
        <div class="local-dixeo-consent-body">
            {{> local_dixeo/consent_sections }}
        </div>
        <form class="local-dixeo-consent-form"
              method="post"
              action="{{actionurl}}"
              autocomplete="off"
              id="local-dixeo-consent-form">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="accept">
            <input type="hidden" name="courseid" value="{{courseid}}">
            <input type="hidden" name="returnurl" value="{{returnurl}}">
            <input type="hidden" name="version" value="{{version}}">
            <label class="local-dixeo-consent-check" for="local-dixeo-consent-terms">
                <input type="checkbox" name="terms" id="local-dixeo-consent-terms" value="1" required>
                <span>{{termscheckbox}}</span>
            </label>
            <label class="local-dixeo-consent-check" for="local-dixeo-consent-processing">
                <input type="checkbox" name="processing" id="local-dixeo-consent-processing" value="1" required>
                <span>{{processingcheckbox}}</span>
            </label>
            <div class="local-dixeo-consent-actions">
                <a class="btn btn-secondary" href="{{exiturl}}">{{exitlabel}}</a>
                <button type="submit"
                        class="btn btn-primary"
                        id="local-dixeo-consent-continue"
                        disabled>{{continuelabel}}</button>
            </div>
        </form>
    </div>
</div>
