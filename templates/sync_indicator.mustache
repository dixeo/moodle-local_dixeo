{{!
    @template local_dixeo/sync_indicator

    Compact file sync status pill. The button opens the Dixeo settings modal on the Status tab.

    Context variables required:
    * courseid - The course ID
    * contextid - The course context ID
    * coursename - The course name shown in the modal breadcrumb
    * status - Current sync status (none, syncing, synchronized, error, paused)
    * enabled - Whether sync is enabled
    * statusclass - CSS class for status (none, syncing, synchronized, error, paused, disabled)
    * tooltip - Tooltip text for the button
    * badgelabel - Optional file count shown on the pill
    * canmanagesync - Whether the user may enable, pause, or turn off sync

    Example context (json):
    {
        "courseid": 2,
        "contextid": 15,
        "coursename": "Sample course",
        "status": "synchronized",
        "enabled": true,
        "canmanagesync": true,
        "statusclass": "synchronized",
        "tooltip": "Files synchronized"
    }
}}
<div id="dixeo-sync-indicator"
     class="dixeo-sync-indicator{{#footer}} dixeo-sync-indicator--footer{{/footer}}"
     data-courseid="{{courseid}}"
     data-status="{{status}}"
     data-enabled="{{enabled}}">

    <button type="button"
            class="dixeo-sync-btn dixeo-sync-btn--{{statusclass}}"
            title="{{#str}}filesync_title, local_dixeo{{/str}}: {{tooltip}}"
            aria-label="{{#str}}filesync_title, local_dixeo{{/str}}: {{tooltip}}"
            aria-haspopup="dialog"
            data-action="local-dixeo-settings-open"
            data-contextid="{{contextid}}"
            data-courseid="{{courseid}}"
            data-course-name="{{coursename}}"
            data-canmanagesync="{{#canmanagesync}}1{{/canmanagesync}}{{^canmanagesync}}0{{/canmanagesync}}"
            data-initial="status">
        <span class="dixeo-sync-btn__brand">Dixeo</span>
        <span class="dixeo-sync-btn__dot" aria-hidden="true"></span>
        {{#badgelabel}}
        <span class="dixeo-sync-btn__count" data-region="sync-badge-count">{{badgelabel}}</span>
        {{/badgelabel}}
        {{^badgelabel}}
        <span class="dixeo-sync-btn__count d-none" data-region="sync-badge-count">0</span>
        {{/badgelabel}}
    </button>
</div>
