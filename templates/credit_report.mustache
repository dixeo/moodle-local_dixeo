{{!
    @template local_dixeo/credit_report

    Credit usage report with balance, filters, KPIs, charts, and table.

    Context variables required for this template:
    * configured - bool - Whether the API is configured.
    * error - string|null - Error message if any.
    * balance - object - Credit balance information.
    * period - object - Active period label and navigation URLs.
    * views - array - Period view toggle links.
    * filters - object - Filter form values and options.
    * kpis - object - Summary KPI values.
    * histogramdata - string - JSON histogram chart data.
    * breakdowndata - string - JSON donut chart data.
    * rows - array - Paginated usage rows.
    * pagination - object - Pagination metadata.
}}
{{#error}}
    <div class="alert alert-danger" role="alert">{{error}}</div>
    {{^configured}}
        <a href="{{settingsurl}}" class="btn btn-primary">{{#str}}configure_api, local_dixeo{{/str}}</a>
    {{/configured}}
{{/error}}

{{^error}}
    <div class="card mb-4">
        <div class="card-header">
            <h4 class="mb-0">{{#str}}current_balance, local_dixeo{{/str}}</h4>
        </div>
        <div class="card-body">
            <div class="d-flex align-items-center" style="gap: 1rem;">
                <span class="h2 mb-0">{{balance.formatted}}</span>
                <span class="badge bg-{{balance.stateclass}}">{{balance.statedescription}}</span>
            </div>
            {{#balance.isfrozen}}
                <div class="alert alert-warning mt-3 mb-0">{{#str}}account_frozen_warning, local_dixeo{{/str}}</div>
            {{/balance.isfrozen}}
            {{#balance.issuspended}}
                <div class="alert alert-danger mt-3 mb-0">{{#str}}account_suspended_warning, local_dixeo{{/str}}</div>
            {{/balance.issuspended}}
        </div>
    </div>

    <div class="card mb-4 local-dixeo-credit-report">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h4 class="mb-0">{{#str}}credit_report_filters, local_dixeo{{/str}}</h4>
            <div class="btn-group" role="group" aria-label="{{#str}}credit_report_period, local_dixeo{{/str}}">
                {{#views}}
                    <a href="{{url}}" class="btn btn-sm {{#active}}btn-primary{{/active}}{{^active}}btn-outline-secondary{{/active}}">{{label}}</a>
                {{/views}}
            </div>
        </div>
        <div class="card-body">
            {{^period.iscustom}}
                <div class="d-flex flex-wrap justify-content-center align-items-center mb-3">
                    <a href="{{period.prevurl}}" class="btn btn-outline-secondary btn-sm me-4 {{^period.hasprev}}disabled{{/period.hasprev}}" aria-label="{{#str}}credit_report_prev_period, local_dixeo{{/str}}">&larr;</a>
                    <h5 class="mb-0 mx-2">{{period.label}}</h5>
                    <a href="{{period.nexturl}}" class="btn btn-outline-secondary btn-sm ms-4 {{^period.hasnext}}disabled{{/period.hasnext}}" aria-label="{{#str}}credit_report_next_period, local_dixeo{{/str}}">&rarr;</a>
                </div>
            {{/period.iscustom}}

            <form method="get" action="{{filters.action}}" class="row g-3">
                <input type="hidden" name="view" value="{{filters.view}}">
                {{#filters.anchor}}<input type="hidden" name="anchor" value="{{filters.anchor}}">{{/filters.anchor}}

                {{#period.iscustom}}
                    <div class="col-12 mb-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <h5 class="dixeo-credit-report-filter-label" for="datefrom">{{#str}}from{{/str}}</h5>
                                <input type="date" class="form-control" id="datefrom" name="datefrom" value="{{filters.datefromformatted}}">
                            </div>
                            <div class="col-md-3">
                                <h5 class="dixeo-credit-report-filter-label" for="dateto">{{#str}}to{{/str}}</h5>
                                <input type="date" class="form-control" id="dateto" name="dateto" value="{{filters.datetoformatted}}">
                            </div>
                        </div>
                    </div>
                {{/period.iscustom}}

                <div class="col-md-3">
                    <label class="dixeo-credit-report-filter-label" for="component">{{#str}}credit_report_filter_component, local_dixeo{{/str}}</label>
                    <select class="form-control dixeo-credit-report-filter-select" id="component" name="component[]" multiple size="5">
                        {{#filters.components}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/filters.components}}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="dixeo-credit-report-filter-label" for="jobtype">{{#str}}credit_report_filter_action, local_dixeo{{/str}}</label>
                    <select class="form-control dixeo-credit-report-filter-select" id="jobtype" name="jobtype[]" multiple size="5">
                        {{#filters.jobtypes}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/filters.jobtypes}}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="dixeo-credit-report-filter-label" for="moduletype">{{#str}}credit_report_filter_moduletype, local_dixeo{{/str}}</label>
                    <select class="form-control dixeo-credit-report-filter-select" id="moduletype" name="moduletype[]" multiple size="5">
                        {{#filters.moduletypes}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/filters.moduletypes}}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="dixeo-credit-report-filter-label" for="userid">{{#str}}credit_report_filter_user, local_dixeo{{/str}}</label>
                    <select class="form-control dixeo-credit-report-filter-select" id="userid" name="userid[]" multiple size="5">
                        {{#filters.users}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/filters.users}}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="dixeo-credit-report-filter-label" for="courseid">{{#str}}credit_report_filter_course, local_dixeo{{/str}}</label>
                    <select class="form-control dixeo-credit-report-filter-select" id="courseid" name="courseid[]" multiple size="5">
                        {{#filters.courses}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/filters.courses}}
                    </select>
                </div>
                <div class="col-12 d-flex justify-content-end align-items-center mt-2 pt-2">
                    <button type="submit" class="btn btn-primary me-2">{{#str}}credit_report_apply_filters, local_dixeo{{/str}}</button>
                    <a href="{{reseturl}}" class="btn btn-secondary">{{#str}}credit_report_reset_filters, local_dixeo{{/str}}</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">{{#str}}credit_report_kpi_credits, local_dixeo{{/str}}</div><div class="h4 mb-0">{{kpis.credits}}</div></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">{{#str}}credit_report_kpi_users, local_dixeo{{/str}}</div><div class="h4 mb-0">{{kpis.users}}</div></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">{{#str}}credit_report_kpi_courses, local_dixeo{{/str}}</div><div class="h4 mb-0">{{kpis.courses}}</div></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">{{#str}}credit_report_kpi_rows, local_dixeo{{/str}}</div><div class="h4 mb-0">{{kpis.rows}}</div></div></div></div>
    </div>

    {{#haschartdata}}
        <div class="row mb-4">
            <div class="col-lg-8">
                <div class="card h-100">
                    <div class="card-header"><h5 class="mb-0">{{#str}}credit_report_histogram, local_dixeo{{/str}}</h5></div>
                    <div class="card-body"><canvas id="creditUsageHistogram" height="120"></canvas></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header"><h5 class="mb-0">{{#str}}credit_report_breakdown, local_dixeo{{/str}}</h5></div>
                    <div class="card-body"><canvas id="creditUsageBreakdown" height="120"></canvas></div>
                </div>
            </div>
        </div>
    {{/haschartdata}}

    <div class="card">
        <div class="card-header"><h4 class="mb-0">{{#str}}recent_transactions, local_dixeo{{/str}}</h4></div>
        <div class="card-body">
            {{#hasrows}}
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>{{#str}}credit_report_column_credits, local_dixeo{{/str}}</th>
                                <th>{{#str}}credit_report_column_module, local_dixeo{{/str}}</th>
                                <th>{{#str}}credit_report_column_action, local_dixeo{{/str}}</th>
                                <th>{{#str}}credit_report_column_date, local_dixeo{{/str}}</th>
                                <th>{{#str}}credit_report_column_user, local_dixeo{{/str}}</th>
                                <th>{{#str}}credit_report_column_course, local_dixeo{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#rows}}
                                <tr>
                                    <td>{{creditsformatted}}</td>
                                    <td>{{componentlabel}}</td>
                                    <td>{{actionlabel}}</td>
                                    <td><span class="text-nowrap">{{dateformatted}}</span></td>
                                    <td>
                                        {{#userurl}}<a href="{{userurl}}">{{userlabel}}</a>{{/userurl}}
                                        {{^userurl}}{{userlabel}}{{/userurl}}
                                    </td>
                                    <td>
                                        {{#courseurl}}<a href="{{courseurl}}">{{courselabel}}</a>{{/courseurl}}
                                        {{^courseurl}}{{courselabel}}{{/courseurl}}
                                    </td>
                                </tr>
                            {{/rows}}
                        </tbody>
                    </table>
                </div>
                {{#haspagination}}
                    <nav aria-label="{{#str}}pagination, local_dixeo{{/str}}">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item {{^pagination.hasprev}}disabled{{/pagination.hasprev}}">
                                <a class="page-link" href="{{pagination.prevurl}}">{{#str}}previous{{/str}}</a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">{{pagination.page}} / {{pagination.totalpages}}</span>
                            </li>
                            <li class="page-item {{^pagination.hasnext}}disabled{{/pagination.hasnext}}">
                                <a class="page-link" href="{{pagination.nexturl}}">{{#str}}next{{/str}}</a>
                            </li>
                        </ul>
                    </nav>
                {{/haspagination}}
            {{/hasrows}}
            {{^hasrows}}
                <div class="alert alert-info mb-0">{{#str}}credit_report_no_rows, local_dixeo{{/str}}</div>
            {{/hasrows}}
        </div>
    </div>

    {{#haschartdata}}
        <script type="application/json" id="credit-report-histogram-data">{{{histogramdata}}}</script>
        <script type="application/json" id="credit-report-breakdown-data">{{{breakdowndata}}}</script>
    {{/haschartdata}}
{{/error}}
