{{!
    @template local_dixeo/consent_sections

    Three sections of the Dixeo terms and privacy text.

    Context variables required:
    * sections - List of heading, id, and blocks (paragraph or list)
    * hasdataprotection - True when a data-privacy requests link is shown
    * dataprotectionurl - Data-privacy requests URL
    * dataprotectionlabel - Label for that link

    Example context (json):
    {
        "sections": [
            {
                "id": "local-dixeo-consent-terms-section",
                "heading": "Terms of Use",
                "blocks": [
                    {
                        "paragraph": "These terms are a contract."
                    },
                    {
                        "list": true,
                        "items": [
                            {
                                "text": "Your user id"
                            }
                        ]
                    }
                ]
            }
        ],
        "hasdataprotection": true,
        "dataprotectionurl": "https://example.com/privacy",
        "dataprotectionlabel": "Open your data privacy requests"
    }
}}
{{#sections}}
<section class="local-dixeo-consent-section" id="{{id}}">
    <h3>{{heading}}</h3>
    {{#blocks}}
        {{#paragraph}}<p>{{paragraph}}</p>{{/paragraph}}
        {{#list}}
        <ul>
            {{#items}}<li>{{text}}</li>{{/items}}
        </ul>
        {{/list}}
    {{/blocks}}
</section>
{{/sections}}
{{#hasdataprotection}}
<p class="local-dixeo-consent-dataprotection">
    <a href="{{dataprotectionurl}}">{{dataprotectionlabel}}</a>
</p>
{{/hasdataprotection}}
